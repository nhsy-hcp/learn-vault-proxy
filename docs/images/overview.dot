// README overview diagram. Render with: task docs:diagram
// Keep it version-free: no image tags, chart versions or TTL values.
digraph overview {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13, nodesep=0.5, ranksep=0.9, pad=0.3,
         labelloc=t, label=<<b>learn-vault-proxy</b><br/><font point-size="11">Vault Kubernetes auth · Vault Proxy sidecar on a UNIX socket · dynamic PostgreSQL credentials</font><br/> >];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#6b7280", fontname="Helvetica", fontsize=11, margin="0.15,0.08"];
  edge  [fontname="Helvetica", fontsize=10, color="#4b5563", fontcolor="#374151"];

  operator [label=<<b>Operator laptop</b><br/>task all · task demo:*<br/>localhost:8200 → Vault>, fillcolor="#f3f4f6"];

  subgraph cluster_k3d {
    label=<<b>k3d cluster</b>>; style="rounded"; color="#6b7280"; fontsize=12;

    subgraph cluster_app {
      label=<<b>Namespace db-app-&lt;application&gt;-&lt;environment&gt;</b><br/><font point-size="10">one per apps.json entry</font>>;
      style="rounded,dashed"; color="#ea580c"; bgcolor="#fff7ed";

      sa [label=<<b>ServiceAccount</b><br/>annotations:<br/>application_name · environment · team>];

      subgraph cluster_pod {
        label=<<b>Pod</b>>; style="rounded"; color="#9ca3af"; bgcolor="#ffffff";
        app    [label=<<b>app</b> (db-app, Python)<br/>stdlib HTTP, no Vault token>];
        proxy  [label=<<b>vault-proxy</b><br/>native sidecar · auto_auth<br/>caches leases>, fillcolor="#dbeafe", color="#1d4ed8"];
        {rank=same; app; proxy;}
      }
    }

    subgraph cluster_vault {
      label=<<b>Namespace vault</b>>; style="rounded"; color="#374151"; bgcolor="#f9fafb";
      vault [label=<<b>Vault Community Edition</b><br/>auth/kubernetes · role db-app<br/>one templated policy db-app<br/>db/ database engine · kvv2/ KV v2>];
    }

    k8sapi [label=<<b>Kubernetes API</b><br/>projected tokens · TokenReview<br/>ServiceAccount annotations>, fillcolor="#e5e7eb"];

    subgraph cluster_pg {
      label=<<b>Namespace postgres</b>>; style="rounded"; color="#15803d"; bgcolor="#f0fdf4";
      pg [label=<<b>PostgreSQL</b><br/>one database per environment<br/>one schema per application<br/>one dynamic user per lease>, fillcolor="#ecfdf5", color="#15803d"];
    }
  }

  note [shape=note, fillcolor="#fefce8", color="#ca8a04", fontsize=10,
        label="No Vault token or database password\nin any pod spec or image"];

  {rank=same; operator; note;}
  operator -> note   [style=invis];
  operator -> vault  [label="configure"];
  sa       -> proxy  [label="projected token", style=dashed, color="#9ca3af"];
  proxy    -> app    [dir=both, arrowsize=0.7, label=" UNIX socket\n /run/vault/proxy.sock", fontsize=9];
  proxy    -> vault  [label="login · read creds and API key · renew", penwidth=1.6];
  vault    -> k8sapi [label="TokenReview · read SA", style=dashed, color="#9ca3af"];
  vault    -> pg     [label="CREATE / DROP ROLE"];
  app      -> pg     [label="connect as leased user", color="#15803d", fontcolor="#15803d", penwidth=1.6];
}
